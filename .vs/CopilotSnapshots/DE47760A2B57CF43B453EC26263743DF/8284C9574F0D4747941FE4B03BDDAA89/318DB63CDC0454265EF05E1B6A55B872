// SceneHierarchyPanel.cpp
#include "SceneHierarchyPanel.h"
#include "imgui.h"

using namespace Engine::Editor;

void SceneHierarchyPanel::Draw(EditorContext& context)
{
    ImGui::Begin("Scene Hierarchy");

    if (!context.ActiveScene)
    {
        ImGui::Text("No active scene");
        ImGui::End();
        return;
    }

    Engine::Scene::SceneObject* objectToDelete = nullptr;

    for (auto& obj : context.ActiveScene->GetObjects())
    {
        bool selected = (context.SelectedObject == obj.get());

        if (ImGui::Selectable(obj->GetName().c_str(), selected))
        {
            context.SelectedObject = obj.get();
        }

        // Right-click context menu
        if (ImGui::BeginPopupContextItem())
        {
            if (ImGui::MenuItem("Delete"))
            {
                objectToDelete = obj.get();
            }
            ImGui::EndPopup();
        }
    }

    // Delete object after iteration (to avoid invalidating iterator)
    if (objectToDelete)
    {
        if (context.SelectedObject == objectToDelete)
            context.SelectedObject = nullptr;
        
        context.ActiveScene->DestroyObject(objectToDelete);
    }

    // Right-click on empty space to create new object
    if (ImGui::BeginPopupContextWindow(nullptr, ImGuiPopupFlags_NoOpenOverItems | ImGuiPopupFlags_MouseButtonRight))
    {
        if (ImGui::MenuItem("Create Empty"))
        {
            auto* newObj = context.ActiveScene->CreateObject("New Object");
            context.SelectedObject = newObj;
        }
        ImGui::EndPopup();
    }

    ImGui::End();
}
